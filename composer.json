{
  "name": "iquesters/community",
  "description": "Members, a configurable member directory, approval, plans and tags for Laravel apps (alumni associations, clubs, societies).",
  "keywords": [
    "laravel",
    "community",
    "membership",
    "alumni",
    "member-directory",
    "iquesters"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iquesters/community",
  "support": {
    "issues": "https://github.com/iquesters/community/issues",
    "source": "https://github.com/iquesters/community",
    "docs": "https://github.com/iquesters/community/tree/main/docs"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "iquesters/foundation": "^2.0",
    "iquesters/user-interface": "^2.0",
    "iquesters/organisation": "^2.0",
    "spatie/laravel-permission": "^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/sanctum": "^4.0",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../foundation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/foundation": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../user-interface",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/user-interface": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../organisation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/organisation": "2.x-dev"
        }
      }
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "autoload": {
    "psr-4": {
      "Iquesters\\Community\\": "src/",
      "Iquesters\\Community\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\Community\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\Community\\CommunityServiceProvider"
      ]
    },
    "platform": {
      "api": {
        "prefix": "community",
        "versions": {
          "v1": "routes/api.v1.php"
        }
      }
    }
  }
}
